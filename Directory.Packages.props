<Project>

  <!-- Central Package Management: every NuGet version in the repository lives
       here, and nowhere else.

       THE PROBLEM THIS SOLVES. dependabot.yml lists each project directory
       separately, and a `directories:` entry is its OWN update scope - a group
       cannot span two of them. So a package declared in two csprojs got bumped
       in one and not the other. Measured on PR #48: System.Drawing.Common went
       to 10.* in JMSML.csproj while StpSDK.csproj stayed at 9.*, and restore
       failed with NU1605 "Detected package downgrade ... from 10.0 to 9.0.20"
       on BOTH runners. The same shape had already been worked around for the
       runtime family with grouping, which is why the groups below exist.

       With one version per package in one file, "bumped here but not there" is
       no longer expressible. NLog and Microsoft.Extensions.Hosting were each
       declared in TEN sample projects; they are now one line each.

       Adding a package: add a PackageVersion here, then reference it from the
       project WITHOUT a Version attribute. A Version attribute on a
       PackageReference is an error under CPM, which is the point - it cannot
       drift back. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="coverlet.collector"                                  Version="6.0.0" />
    <PackageVersion Include="DynamicData"                                         Version="9.4.33" />
    <PackageVersion Include="Fody"                                                Version="6.8.0" />
    <PackageVersion Include="Microsoft.CognitiveServices.Speech"                  Version="1.37.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting"                        Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging"                        Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions"           Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console"                Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk"                              Version="17.6.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub"                         Version="10.0.401" />
    <PackageVersion Include="Newtonsoft.Json"                                     Version="13.0.3" />
    <PackageVersion Include="Nlog"                                                Version="5.3.2" />
    <PackageVersion Include="Nlog.Extensions.Logging"                             Version="5.3.10" />
    <PackageVersion Include="NUnit"                                               Version="3.13.3" />
    <PackageVersion Include="NUnit.Analyzers"                                     Version="3.6.1" />
    <PackageVersion Include="NUnit3TestAdapter"                                   Version="4.5.0" />
    <PackageVersion Include="PropertyChanged.Fody"                                Version="4.1.0" />
    <PackageVersion Include="ReactiveUI"                                          Version="20.1.1" />
    <PackageVersion Include="Svg"                                                 Version="3.4.7" />
    <PackageVersion Include="System.Drawing.Common"                               Version="10.0.12" />
    <PackageVersion Include="System.Reactive.Linq"                                Version="6.1.0" />
    <PackageVersion Include="System.Resources.Extensions"                         Version="10.0.12" />
    <PackageVersion Include="System.Threading.Tasks.Dataflow"                     Version="10.0.12" />
    <PackageVersion Include="Teronis.MSBuild.Packaging.ProjectBuildInPackage"     Version="1.0.0" />
    <PackageVersion Include="Websocket.Client"                                    Version="5.5.0" />
  </ItemGroup>

</Project>
