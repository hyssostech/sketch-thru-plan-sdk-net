<Project Sdk="Microsoft.NET.Sdk">

  <!-- STP-775. Migrated from the legacy (pre-SDK) csproj format.

       What the old format cost: the project could only be built by VS MSBuild,
       so `dotnet build` could not touch it, it was never added to StpSDK.sln,
       and CI builds only the solution - which meant the ONE project proving the
       netstandard2.0 target still works for .NET Framework consumers was built
       by nothing at all.

       Dropped in the migration, all verified unused first:
         - Fody + PropertyChanged.Fody (and FodyWeavers.xml): no type in this
           sample implements INotifyPropertyChanged or is decorated for it.
         - packages.config: superseded by PackageReference. It also still listed
           HyssosTech.Sdk.STP 0.2.5 while the project used a ProjectReference,
           so it had been lying about this project's dependencies for some time.
         - The explicit Microsoft.Extensions.Logging.Abstractions HintPath
           reference into ..\packages\: arrives transitively from StpSDK now.
         - Properties/AssemblyInfo.cs: the SDK generates these attributes.
         - The manual bindingRedirects in App.config:
           AutoGenerateBindingRedirects computes them. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>DotNetFrameworkSample</RootNamespace>
    <AssemblyName>DotNetFrameworkSample</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <!-- This sample exists to exercise the netstandard2.0 leg of the SDK from a
         real .NET Framework host. It cannot build off Windows, so it is kept
         out of StpSDK.sln (which the ubuntu CI leg builds) and is built by a
         Windows-only CI step instead. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StpSDK.JsonRpc\StpSDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- JMSML runtime data. The Librarian resolves LibraryPath="JMS/Instance"
         relative to the working directory, so this has to sit next to the exe. -->
    <Content Include="JMS\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
