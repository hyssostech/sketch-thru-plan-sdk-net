<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="NUnit.Analyzers" Version="3.10.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StpSDK.JsonRpc\StpSDK.csproj" />
    <!-- StpSDK references JMSML with PrivateAssets="all" so that it is embedded
         in the nupkg rather than declared as a dependency, which also stops it
         reaching this project. SvgCompositorTests exercises a JMSML type
         directly, so reference it here as well. -->
    <ProjectReference Include="..\..\third-party\JMSML\JMSML.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- STP-775. Fixture SVG layers for SvgCompositorTests. They stand in for
         the shipped graphic set, which lives outside the repo under
         C:\ProgramData\STP\JMS\svg and is not available to CI. -->
    <Content Include="TestData\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
