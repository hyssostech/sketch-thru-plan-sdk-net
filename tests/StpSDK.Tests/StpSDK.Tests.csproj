<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StpSDK.JsonRpc\StpSDK.csproj" />
    <!-- StpSDK references JMSML with PrivateAssets="all" so that it is embedded
         in the nupkg rather than declared as a dependency, which also stops it
         reaching this project. SvgCompositorTests exercises a JMSML type
         directly, so reference it here as well. -->
    <ProjectReference Include="..\..\third-party\JMSML\JMSML.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- STP-775. Fixture SVG layers for SvgCompositorTests. They stand in for
         the shipped graphic set, which lives outside the repo under
         C:\ProgramData\STP\JMS\svg and is not available to CI. -->
    <Content Include="TestData\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <!-- STP-1064. The call-validation schema pinned beside the SDK's embedded rule file; the
         tests check it is the pinned copy and that the evaluator reads every keyword it defines. -->
    <Content Include="..\..\src\StpSDK.JsonRpc\Validation\sketch-thru-plan-validations.schema.json"
             Link="TestData\CallValidations\sketch-thru-plan-validations.schema.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
